# --------------------- gwf spg options ---------------------
# flopy multi-package
# package-type stress-package

block options
name auxiliary
type string
shape (naux)
reader urword
optional true
longname keyword to specify aux variables
description REPLACE auxnames {'{#1}': 'Groundwater Flow'}

block options
name boundnames
type keyword
shape
reader urword
optional true
longname
description REPLACE boundnames {'{#1}': 'seepage'}

block options
name print_input
type keyword
reader urword
optional true
longname print input to listing file
description REPLACE print_input {'{#1}': 'seepage'}
mf6internal iprpak

block options
name print_flows
type keyword
reader urword
optional true
longname print seepage rates to listing file
description REPLACE print_flows {'{#1}': 'seepage'}
mf6internal iprflow

block options
name save_flows
type keyword
reader urword
optional true
longname save seepage flows to budget file
description REPLACE save_flows {'{#1}': 'seepage'}
mf6internal ipakcb

block options
name ibound_toggle
type keyword
reader urword
optional true
longname use constant-head ibound toggle method
description keyword to activate the constant-head ibound toggle method for enforcing the active seepage state.  When this keyword is specified, each active seepage cell is temporarily converted to a true constant-head cell (held at the seepage elevation) while it is discharging, and released back to an ordinary active cell (no-flow seepage boundary) when the flow would reverse into the simulated domain.  When this keyword is not specified, the active seepage state is instead enforced with a large penalty conductance that holds the cell head near the seepage elevation.

block options
name penalty_conductance
type double precision
reader urword
optional true
longname penalty conductance for the active seepage state
description value of the conductance used to hold the cell head near the seepage elevation when the penalty method is active (that is, when IBOUND_TOGGLE is not specified).  This value should be large relative to the conductances of the connections to the seepage cell.  If PENALTY_CONDUCTANCE is not specified, a default value of 1.0e9 is used.
mf6internal penalty_cond


# --------------------- gwf spg dimensions ---------------------

block dimensions
name maxbound
type integer
reader urword
optional false
longname maximum number of seepage cells
description REPLACE maxbound {'{#1}': 'seepage cells'}


# --------------------- gwf spg period ---------------------

block period
name iper
type integer
block_variable True
in_record true
tagged false
shape
valid
reader urword
optional false
longname stress period number
description REPLACE iper {}

block period
name stress_period_data
type recarray cellid aux boundname
shape (maxbound)
reader urword
longname
description
mf6internal spd

block period
name cellid
type integer
shape (ncelldim)
tagged false
in_record true
reader urword
longname cell identifier
description REPLACE cellid {}

block period
name aux
type double precision
in_record true
tagged false
shape (naux)
reader urword
optional true
longname auxiliary variables
description REPLACE aux {'{#1}': 'seepage boundary'}
mf6internal auxvar

block period
name boundname
type string
shape
tagged false
in_record true
reader urword
optional true
longname seepage boundary name
description REPLACE boundname {'{#1}': 'seepage'}
