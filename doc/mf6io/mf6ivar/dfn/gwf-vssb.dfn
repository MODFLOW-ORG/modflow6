# --------------------- gwf vssb options ---------------------
# flopy multi-package
# package-type advanced-stress-package

block options
name auxiliary
type string
shape (naux)
reader urword
optional true
longname keyword to specify aux variables
description REPLACE auxnames {'{#1}': 'Groundwater Flow'}

block options
name auxmultname
type string
shape
reader urword
optional true
longname name of auxiliary variable for multiplier
description REPLACE auxmultname {'{#1}': 'precipitation rate'}

block options
name boundnames
type keyword
shape
reader urword
optional true
longname
description REPLACE boundnames {'{#1}': 'surface'}

block options
name print_input
type keyword
reader urword
optional true
longname print input to listing file
description REPLACE print_input {'{#1}': 'surface boundary'}
mf6internal iprpak

block options
name print_flows
type keyword
reader urword
optional true
longname print calculated flows to listing file
description REPLACE print_flows {'{#1}': 'surface boundary'}

block options
name save_flows
type keyword
reader urword
optional true
longname save flows to budget file
description REPLACE save_flows {'{#1}': 'surface boundary'}
mf6internal ipakcb

block options
name pond_filerecord
type record ponddepth fileout ponddepthfile
shape
reader urword
tagged true
optional true
longname
description

block options
name ponddepth
type keyword
shape
in_record true
reader urword
tagged true
optional false
longname pond depth keyword
description keyword to specify that record corresponds to pond depth.

block options
name fileout
type keyword
shape
in_record true
reader urword
tagged true
optional false
longname file keyword
description keyword to specify that an output filename is expected next.

block options
name ponddepthfile
type string
preserve_case true
shape
in_record true
reader urword
tagged false
optional false
longname pond depth file keyword
description name of the binary output file to write pond depth data.  The pond depth file has the same format as the head file, with one value for each model cell; cells that are not surface cells have a pond depth of zero.  Pond depth values will be written to the file whenever (hydraulic) heads are written to the binary head file.  The settings for controlling head output are contained in the Output Control option.

block options
name ts_filerecord
type record ts6 filein ts6_filename
shape
reader urword
tagged true
optional true
longname
description

block options
name ts6
type keyword
shape
in_record true
reader urword
tagged true
optional false
longname head keyword
description keyword to specify that record corresponds to a time-series file.

block options
name filein
type keyword
shape
in_record true
reader urword
tagged true
optional false
longname file keyword
description keyword to specify that an input filename is expected next.

block options
name ts6_filename
type string
preserve_case true
in_record true
reader urword
optional false
tagged false
longname file name of time series information
description REPLACE timeseriesfile {}

block options
name obs_filerecord
type record obs6 filein obs6_filename
shape
reader urword
tagged true
optional true
longname
description

block options
name obs6
type keyword
shape
in_record true
reader urword
tagged true
optional false
longname obs keyword
description keyword to specify that record corresponds to an observations file.

block options
name obs6_filename
type string
preserve_case true
in_record true
tagged false
reader urword
optional false
longname obs6 input filename
description REPLACE obs6_filename {'{#1}': 'VSSB', '{#2}': '\\ref{table:gwf-obstypetable}'}

block options
name mover
type keyword
tagged true
reader urword
optional true
longname
description REPLACE mover {'{#1}': 'VSSB'}


# --------------------- gwf vssb dimensions ---------------------

block dimensions
name nsurfcells
type integer
reader urword
optional false
mf6internal maxbound
longname number of surface cells
description is the number of surface cells.  Only one surface cell can be assigned to a GWF cell.


# --------------------- gwf vssb packagedata ---------------------

block packagedata
name packagedata
type recarray ifno cellid max_pond_depth boundname
shape (nsurfcells)
reader urword
longname
description

block packagedata
name ifno
mf6internal packagedata_ifno
type integer
shape
tagged false
in_record true
reader urword
longname surface cell id number for this entry
description integer value that defines the surface cell number associated with the specified PACKAGEDATA data on the line. IFNO must be greater than zero and less than or equal to NSURFCELLS.  Information must be specified for every surface cell or the program will terminate with an error.  The program will also terminate with an error if information for a surface cell is specified more than once.
numeric_index true

block packagedata
name cellid
type integer
shape (ncelldim)
tagged false
in_record true
reader urword
longname cell identifier
description REPLACE cellid {}

block packagedata
name max_pond_depth
type double precision
shape
tagged false
in_record true
reader urword
longname maximum pond depth
description is the maximum depth of water that can be stored on the land surface of the cell.  Water in excess of this depth leaves the package as runoff.  MAX\_POND\_DEPTH must be greater than or equal to zero; a value of zero means that no water is stored on the land surface.

block packagedata
name boundname
type string
shape
tagged false
in_record true
reader urword
optional true
longname surface cell name
description REPLACE boundname {'{#1}': 'surface cell'}


# --------------------- gwf vssb period ---------------------

block period
name iper
type integer
block_variable true
in_record true
tagged false
shape
valid
reader urword
optional false
longname stress period number
description REPLACE iper {}

block period
name perioddata
type recarray ifno precipitation evaporation aux
shape
reader urword
longname
description

block period
name ifno
type integer
shape
tagged false
in_record true
reader urword
longname surface cell id number
description integer value that defines the surface cell number associated with the specified PERIOD data on the line.
numeric_index true

block period
name precipitation
type double precision
shape
tagged false
in_record true
time_series true
reader urword
longname precipitation rate
description real or character value that defines the precipitation rate applied to the top of the surface cell ($LT^{-1}$).  The value must be greater than or equal to zero.  If the Options block includes a TIMESERIESFILE entry (see the ``Time-Variable Input'' section), values can be obtained from a time series by entering the time-series name in place of a numeric value.

block period
name evaporation
type double precision
shape
tagged false
in_record true
time_series true
reader urword
longname potential evaporation rate
description real or character value that defines the potential evaporation rate applied to the surface cell ($LT^{-1}$).  The value must be greater than or equal to zero.  Evaporation is removed first from any ponded water at the potential rate, and the remaining demand is applied to the soil as bare-soil evaporation, reduced by the relative permeability of the top cell.  A value of zero means that no evaporation is simulated.  If the Options block includes a TIMESERIESFILE entry (see the ``Time-Variable Input'' section), values can be obtained from a time series by entering the time-series name in place of a numeric value.

block period
name aux
type double precision
in_record true
tagged false
shape (naux)
reader urword
time_series true
optional true
longname auxiliary variables
description REPLACE aux {'{#1}': 'surface boundary'}
